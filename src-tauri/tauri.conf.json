{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-maestri",
  "version": "0.1.0",
  "identifier": "org.openmaestri.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "open-maestri", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
